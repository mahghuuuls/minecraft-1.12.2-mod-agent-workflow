{
  "schema": 1,
  "timeoutSeconds": 900,
  "stopSeconds": 30,
  "allowInterruptionTest": true,
  "steps": [
    {"action": "start", "side": "server"},
    {"action": "console", "side": "server", "text": "setworldspawn 0 4 0", "contains": "Set the world spawn point"},
    {"action": "stop", "side": "server"},
    {"action": "start", "side": "server"},
    {"action": "bundle", "side": "server", "name": "runtime_server_create"},
    {"action": "stop", "side": "server"},
    {"action": "start", "side": "server"},
    {"action": "bundle", "side": "server", "name": "runtime_server_reopen"},
    {"action": "stop", "side": "server"},
    {"action": "start", "side": "client", "timeout": 180},
    {"action": "request", "side": "client", "channel": "client-inbox", "text": "create smoke-{run} type=flat structures=false"},
    {"action": "request", "side": "client", "text": "run runtime_client_create"},
    {"action": "request", "side": "client", "text": "run runtime_negative", "expect": "failed", "reason": "bundleFailed"},
    {"action": "screenshot", "side": "client"},
    {"action": "stop", "side": "client"},
    {"action": "start", "side": "client", "timeout": 180},
    {"action": "request", "side": "client", "channel": "client-inbox", "text": "open smoke-{run}"},
    {"action": "request", "side": "client", "text": "run runtime_client_reopen"},
    {"action": "stop", "side": "client"},
    {"action": "start", "side": "server"},
    {"action": "pair"},
    {"action": "start", "side": "client", "timeout": 180},
    {"action": "request", "side": "client", "channel": "client-inbox", "text": "connect localhost:{port}"},
    {"action": "request", "side": "server", "text": "run runtime_client_create"},
    {"action": "request", "side": "server", "text": "run runtime_negative", "expect": "failed", "reason": "bundleFailed"},
    {"action": "screenshot", "side": "server"},
    {"action": "request", "side": "server", "text": "client inventory"},
    {"action": "screenshot", "side": "server"},
    {"action": "request", "side": "server", "text": "client close"},
    {"action": "stop", "side": "client"},
    {"action": "stop", "side": "server"},
    {"action": "start", "side": "server"},
    {"action": "bundle", "side": "server", "name": "runtime_server_reopen"},
    {"action": "interrupt", "side": "server"},
    {"action": "stop", "side": "server"},
    {"action": "start", "side": "server"},
    {"action": "bundle", "side": "server", "name": "runtime_server_reopen"},
    {"action": "stop", "side": "server"}
  ]
}
