/workspace/documentation/*
!/workspace/documentation/.gitkeep

/workspace/project/*
!/workspace/project/.gitkeep

/workspace/template/
/workspace/dependencies/
/workspace/project.properties

/workspace/artwork/

/.claude/
/.idea/

# Accidental output of a shell redirect to `nul` outside cmd, where it is a
# reserved device name rather than a filename.
/nul
